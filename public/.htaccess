# ---------------------------------------------------------------
# Apache config for Hostinger shared hosting (public_html).
# All assets use relative paths, so this works at the domain root
# or in a subfolder.
# ---------------------------------------------------------------

# Default charset
AddDefaultCharset UTF-8

# Directory listing off
Options -Indexes

# ----- HTTPS redirect (Hostinger installs free SSL automatically) -----
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Uncomment if you do NOT sit behind a proxy/CDN:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ----- Security headers (same set as netlify.toml / _headers) -----
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----- Compression -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ----- Caching -----
# Files are NOT content-hashed, so anything that can change without a
# filename change (HTML, CSS, JS, images) must always revalidate —
# otherwise browsers keep serving stale versions for months (this
# caused two live incidents already). 304 responses keep it cheap.
# Only fonts are pinned long-term: they get a NEW filename whenever
# they are replaced.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/png "access plus 0 seconds"
  ExpiresByType image/webp "access plus 0 seconds"
  ExpiresByType image/svg+xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
